#!/usr/bin/env fish
# chezmoi wrapper that supplies this Mac's template data from 1Password.
#
# The data lives in the `chezmoi_macbook` 1Password Environment, one secret
# per value. Each secret is named CHEZMOI__<PATH>, where PATH is the chezmoi
# data path with dots replaced by double underscores and case preserved
# (CHEZMOI__vps__host -> .vps.host, CHEZMOI__op__items__aiPrimary ->
# .op.items.aiPrimary).
#
# Reading 1Password needs the CLI and may need a Touch ID prompt, so the
# mapped JSON is also cached in the login Keychain as a generic password.
# 1Password remains the source of truth:
#
#   - interactive commands refresh the cache when it is older than
#     CHEZMOI_1P_TTL seconds (default 600), so edits in 1Password show up;
#   - background commands (no TTY) only read the cache, so pollers such as
#     sketchybar never trigger a 1Password prompt;
#   - CHEZMOI_1P_REFRESH=1 forces a refresh, CHEZMOI_1P_DEBUG=1 says what the
#     shim decided.
#
# The data is handed to the real chezmoi through a named pipe, so it is never
# written to disk in plaintext. `chezmoi purge` does not remove the cache;
# delete the `chezmoi-macbook-data` Keychain item by hand if you want to.

set -l real /opt/homebrew/bin/chezmoi
if not test -x $real
  printf 'chezmoi: %s not found\n' $real >&2
  exit 1
end

# Commands that do not render templates: run them without 1Password.
if test (count $argv) -gt 0
  if contains -- $argv[1] --version help doctor completion license purge secret
    exec $real $argv
  end
end
if contains -- --help $argv; or contains -- -h $argv
  exec $real $argv
end

set -l environment chezmoi_macbook
set -l service chezmoi-macbook-data
set -l keychain $HOME/Library/Keychains/login.keychain-db
set -l ttl 600
set -q CHEZMOI_1P_TTL; and set ttl $CHEZMOI_1P_TTL
string match -qr '^[0-9]+$' -- $ttl; or set ttl 600

function shim_debug -a message
  if set -q CHEZMOI_1P_DEBUG
    printf 'chezmoi: %s\n' $message >&2
  end
end

# Always name the login keychain explicitly. A bare add/find makes `security`
# search every keychain, which can reach the system-managed `metadata`
# keychain and prompt for a password that does not exist.
function keychain_read -a account service keychain
  command security find-generic-password -a $account -s $service -w $keychain 2>/dev/null
end

function keychain_write -a account service keychain payload
  command security delete-generic-password -a $account -s $service $keychain >/dev/null 2>&1
  set -l hex (printf '%s' $payload | command xxd -p | command tr -d '\n')
  command security add-generic-password -a $account -s $service -X $hex -A $keychain 2>/dev/null
end

# Secrets are matched by name; no mapping table is needed. A secret that is
# missing from the environment is missing from the data, and chezmoi fails
# loudly on the template that needs it.

set -l cached (keychain_read $USER $service $keychain)
set -l fetched 0
set -l data ''
if test -n "$cached"
  set fetched (printf '%s' $cached | command jq -r '.fetchedAt // 0' 2>/dev/null)
  set data (printf '%s' $cached | command jq -c '.data // empty' 2>/dev/null)
end
string match -qr '^[0-9]+$' -- $fetched; or set fetched 0

set -l now (date +%s)
set -l age (math $now - $fetched)
set -l refresh 0
if set -q CHEZMOI_1P_REFRESH
  set refresh 1
else if test -z "$data"
  set refresh 1
else if test $age -ge $ttl; and test -t 0
  set refresh 1
end

if test $refresh -eq 1
  shim_debug "refresh requested (cache age $age seconds)"
  set -l raw (command op environment secret list $environment --reveal --format=json 2>/dev/null)
  if test -n "$raw"
    set -l fresh (printf '%s' $raw | command jq -c '
      (if type == "array" then . else (.secrets // .items // .variables // []) end)
      | map({name: (.name // .Name), value: (.value // .Value // "")})
      | map(select((.name // "") | startswith("CHEZMOI__")))
      | map({path: (.name | ltrimstr("CHEZMOI__") | split("__")), value: .value})
      | reduce .[] as $secret ({}; setpath($secret.path; $secret.value))
    ' 2>/dev/null)
    if test -n "$fresh"; and printf '%s' $fresh | command jq -e '.fullName != "" and .email != ""' >/dev/null 2>&1
      set -l payload (printf '%s' $fresh | command jq -c --argjson at $now '{fetchedAt: $at, data: .}')
      keychain_write $USER $service $keychain $payload
      set data $fresh
      shim_debug 'cache refreshed'
    else
      printf 'chezmoi: %s has no usable data (fullName/email missing)\n' $environment >&2
    end
  else
    printf 'chezmoi: could not read the %s 1Password environment\n' $environment >&2
  end
end

if test -z "$data"
  printf 'chezmoi: no template data and no usable Keychain cache\n' >&2
  printf 'chezmoi: unlock 1Password and run an interactive chezmoi command first\n' >&2
  exit 1
end

set -l dir (command mktemp -d)
set -l fifo $dir/data.json
command mkfifo $fifo
printf '%s' $data | command sh -c 'v=$(cat); while printf %s "$v" > "$1"; do :; done' _ $fifo &
set -l writer $last_pid
command $real --override-data-file $fifo $argv
set -l st $status
kill $writer 2>/dev/null
wait $writer 2>/dev/null
rm -rf $dir
exit $st
