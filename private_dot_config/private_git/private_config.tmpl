# See for a detailed overview
# https://stackoverflow.com/questions/17756753/where-do-the-settings-in-my-git-configuration-come-from/17756808#17756808

# This is Git's per-user configuration file.
[user]
  useConfigOnly = true
  name = {{ .fullName }}
  email = {{ .email }}
	signingkey = {{ .sshSigningKey }}

[log]
  date = local
[core]
  ignorecase = false
	pager = delta
  # pager = hunk pager
[credential]
  helper = osxkeychain
[push]
  autoSetupRemote = true
[pull]
  rebase = true
[http]
  postBuffer = 524288000
[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[format]
  signoff = true
[commit]
  gpgsign = true
# [tag]
#   gpgsign = true
[fetch]
  prune = true
[init]
	defaultBranch = main
[rebase]
	instructionFormat = %s [%ad]

# Make sure the `includeIf` path is not a symlink
# [includeIf "gitdir:~/Documents/"]
#   path = "/Users/paramjit/Documents/.gitconfig"
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
[merge]
	conflictStyle = zdiff3
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
