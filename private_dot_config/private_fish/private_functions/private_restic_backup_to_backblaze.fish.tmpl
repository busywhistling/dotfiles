function restic_backup_to_backblaze
  set -x BUCKET_NAME "macbook-eu"
  
  set -x AWS_ACCESS_KEY_ID (backup_credential primary_username)
  set -x AWS_SECRET_ACCESS_KEY (backup_credential primary_password)
  set -x RESTIC_REPOSITORY "s3:s3.eu-central-003.backblazeb2.com/$BUCKET_NAME"
  set -x RESTIC_PASSWORD (backup_credential primary_restic)
  
  # restic init
  
  caffeinate -i restic backup \
    /Users/paramjit/Music \
    /Users/paramjit/Documents \
    /Users/paramjit/Pictures \
    --exclude-file=/Users/paramjit/.config/restic/excludefile

  if test -d "{{ .media.libraryDir }}"
    set -x BUCKET_NAME "{{ .media.archiveBucket }}"

    set -x AWS_ACCESS_KEY_ID (backup_credential archive_username)
    set -x AWS_SECRET_ACCESS_KEY (backup_credential archive_password)
    set -x RESTIC_REPOSITORY "s3:s3.eu-central-003.backblazeb2.com/$BUCKET_NAME"
    set -x RESTIC_PASSWORD (backup_credential archive_restic)

    # restic init

    caffeinate -i restic backup {{ .media.libraryDir }}
  end
end
