# Print one of the Backblaze credentials restic needs.
#
# 1Password's CLI authorization expires after ten idle minutes, while a restic
# backup runs far longer than that. `maintain` therefore preloads all six
# values at the start of a run (see preload_backup_credentials) and this reads
# them from there, calling `op` only when used on its own.
function backup_credential -a key
  set -l var "BACKUP_CRED_"(string upper $key)
  if set -q $var; and test -n "$$var"
    printf '%s' $$var
    return 0
  end

  switch $key
    case primary_username
      op read "op://Dev/{{ .op.items.backupPrimary }}/Benutzername"
    case primary_password
      op read "op://Dev/{{ .op.items.backupPrimary }}/Anmeldedaten"
    case primary_restic
      op read "op://Dev/{{ .op.items.backupPrimaryRestic }}/password"
    case archive_username
      op read "op://Dev/{{ .op.items.backupArchive }}/Benutzername"
    case archive_password
      op read "op://Dev/{{ .op.items.backupArchive }}/Anmeldedaten"
    case archive_restic
      op read "op://Dev/{{ .op.items.backupArchiveRestic }}/password"
    case "*"
      printf "backup_credential: unknown credential '%s'\n" $key >&2
      return 1
  end
end
