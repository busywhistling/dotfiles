# Maintenance for one machine: update packages, sync, back up.
#
#   maintain               run every step whose interval has elapsed
#   maintain status        when each step last ran and when it is due again
#   maintain --plan        what the next run would execute
#   maintain brew restic   run only those steps, now
#   maintain --force       run every step, ignoring the schedule
#   maintain --help
#
# The command is split by concern:
#
#   utils/maintain_ui.fish        everything printed, and nothing else
#   utils/maintain_run_step.fish  running one step, and the schedule
#   utils/maintain_steps.fish     the step list and what each step does
#
# This file only decides what to run and in which order, and holds the lock.
#
# A step that succeeds records its finish in ~/.cache/maintain/<step>.timestamp
# and leaves its output in <step>.log, so a failed run can be read afterwards.
# A step that returns $MAINTAIN_SKIPPED (42) had nothing to do this time: it is
# not recorded, so the next run looks again.

set -g MAINTAIN_SKIPPED 42

# Autoloading defines only the function named after this file, so pull in the
# rest of the command once, when `maintain` is first used in a shell. The
# helpers live in utils/ instead of functions/ so they are not autoloaded as
# commands of their own.
for __maintain_file in maintain_ui maintain_run_step maintain_steps
  source $__fish_config_dir/utils/$__maintain_file.fish
end
set -e __maintain_file

function maintain
  set -l cache ~/.cache/maintain
  mkdir -p $cache
  chmod 700 $cache 2>/dev/null
  maintain_ui_init

  # --- arguments ----------------------------------------------------------
  set -l mode run
  set -l only
  set -l force 0
  set -l args $argv
  while set -q args[1]
    switch $args[1]
      case -h --help
        maintain_usage
        return 0
      case -s --status status
        set mode status
        set -e args[1]
      case -p --plan --dry-run plan
        set mode plan
        set -e args[1]
      case -o --only
        set -e args[1]
        if not set -q args[1]
          printf 'maintain: --only needs a step name\n' >&2
          return 2
        end
        set -a only (string split -n , -- $args[1])
        set -e args[1]
      case -f --force
        set force 1
        set -e args[1]
      case --unlock
        maintain_unlock $cache
        printf 'maintain: lock removed\n'
        return 0
      case '--*'
        printf 'maintain: unknown option %s (see `maintain --help`)\n' $args[1] >&2
        return 2
      case '*'
        set -a only $args[1]
        set -e args[1]
    end
  end

  set -l steps (maintain_steps)
  set -l names
  for spec in $steps
    set -a names (string split -f 1 -- '|' $spec)
  end
  for name in $only
    if not contains -- $name $names
      printf 'maintain: unknown step %s\n' $name >&2
      printf 'valid steps: %s\n' (string join ' ' $names) >&2
      return 2
    end
  end

  # --- what is due --------------------------------------------------------
  set -l due
  set -l waiting
  set -l excluded
  for spec in $steps
    set -l name (string split -f 1 -- '|' $spec)
    set -l interval (string split -f 2 -- '|' $spec)
    if set -q only[1]
      if contains -- $name $only
        set -a due $spec
      else
        set -a excluded $spec
      end
    else if test $force -eq 1
      set -a due $spec
    else if maintain_due $cache $name $interval
      set -a due $spec
    else
      set -a waiting $spec
    end
  end

  if test $mode = status
    maintain_ui_status $cache
    return 0
  end
  if test $mode = plan
    maintain_ui_plan $cache
    return 0
  end

  if not set -q due[1]
    printf 'maintain: nothing is due; `maintain status` shows when each step runs next\n'
    return 0
  end

  # --- one run at a time --------------------------------------------------
  # Two runs would fight over 1Password, brew, podman and the restic
  # repository. Directory creation is atomic, so it is the lock.
  if not maintain_lock $cache
    return 1
  end

  # Ctrl-C reaches this shell but not a background job, and the spinner is a
  # background job. Stop it, and drop the lock: an interrupted run never
  # reaches the end of this function.
  functions -e maintain_interrupt 2>/dev/null
  function maintain_interrupt --on-signal INT
    if set -q __maintain_stop[1]
      touch $__maintain_stop 2>/dev/null
    end
    maintain_unlock ~/.cache/maintain
    functions -e maintain_interrupt
    printf '\n'
  end

{{ if eq .chezmoi.hostname "macbook" }}
  # 1Password's CLI authorization expires after ten idle minutes, but a single
  # step here (rsync, restic) can run for hours. Unlock it once, up front,
  # before the first long step, and read everything the run needs:
  #
  #   - restic's Backblaze credentials, instead of reading them at the end of
  #     the run when the authorization is long gone;
  #   - CHEZMOI_1P_TTL keeps the chezmoi wrapper on its Keychain cache for the
  #     whole run, so the later `chezmoi add` calls cannot refresh it either.
  #
  # The variable is function-local and exported: only the commands in this run
  # see it, and the next interactive chezmoi command refreshes normally.
  set -lx CHEZMOI_1P_TTL 43200
  if string match -q 'restic_backup_to_backblaze|*' -- $due
    printf 'Unlocking 1Password once for the whole run\n'
    preload_backup_credentials
    or printf 'warning: could not read the backup credentials; restic will read them itself\n'
  end
{{ end }}

  # --- run ----------------------------------------------------------------
  set -l started (date +%s)
  set -l total (count $due)
  set -l index 0
  set -l ran 0
  set -l failed

  for spec in $due
    set index (math $index + 1)
    maintain_run_step $cache $spec $index $total
    set -l code $status
    set ran (math $ran + 1)
    if test $code -ne 0; and test $code -ne $MAINTAIN_SKIPPED
      set -a failed (string split -f 1 -- '|' $spec)
    end
  end

  maintain_ui_title 'maintain: done'
  functions -e maintain_interrupt

  # --- report -------------------------------------------------------------
  set -l waiting_names
  for spec in $waiting
    set -a waiting_names (string split -f 1 -- '|' $spec)
  end
  set -l excluded_names
  for spec in $excluded
    set -a excluded_names (string split -f 1 -- '|' $spec)
  end
  # The report takes plain strings, since fish flattens lists into $argv.
  set -l failed_text (string join ' ' $failed)
  set -l waiting_text (string join ' ' $waiting_names)
  set -l excluded_text (string join ' ' $excluded_names)
  maintain_ui_summary (math (date +%s) - $started) $ran "$failed_text" "$waiting_text" "$excluded_text"

  maintain_unlock $cache
  test (count $failed) -eq 0
end

# --- the lock ------------------------------------------------------------

# The owner is recorded because an interrupted run leaves the directory
# behind: a dead pid, or our own shell (the run that was interrupted), can be
# taken over.
function maintain_lock -a cache
  set -l lock $cache/lock
  if test -d $lock
    set -l holder (cat $lock/pid 2>/dev/null)
    if test -n "$holder"
      if test "$holder" = "$fish_pid"
        rm -rf $lock
      else if kill -0 $holder 2>/dev/null
        set -l since (cat $lock/since 2>/dev/null)
        set -l age ''
        if test -n "$since"
          set age ' ('(maintain_ui_short (math (date +%s) - $since))' ago)'
        end
        printf 'maintain: another run is in progress (pid %s%s)\n' $holder $age >&2
        printf 'maintain: if that run is gone, use `maintain --unlock`\n' >&2
        return 1
      end
    end
    rm -rf $lock
  end
  if not mkdir $lock 2>/dev/null
    printf 'maintain: could not take the lock at %s\n' $lock >&2
    return 1
  end
  printf '%s' $fish_pid > $lock/pid
  date +%s > $lock/since
  return 0
end

function maintain_unlock -a cache
  rm -rf $cache/lock
end

# --- help ----------------------------------------------------------------

function maintain_usage
  printf '%s\n' \
    'Usage: maintain [--force] [--only STEP[,STEP]] [STEP...]' \
    '       maintain status' \
    '       maintain --plan' \
    '' \
    'Run the maintenance steps whose interval has elapsed, one at a time, and' \
    'print a summary. Timestamps and per-step logs live in ~/.cache/maintain; a' \
    'step that fails is not recorded, so the next run retries it. Only one run' \
    'can be active at a time.' \
    '' \
    '  (no arguments)      run every step that is due' \
    '  STEP...             run only the named steps, ignoring the schedule' \
    '  -o, --only LIST     the same, comma-separated' \
    '  -f, --force         run every step, ignoring the schedule' \
    '  -s, --status        when each step last ran and when it is due again' \
    '  -p, --plan          what the next run would execute' \
    '  --unlock            drop the lock left behind by an interrupted run' \
    '  -h, --help' \
    '' \
    'Environment:' \
    '  NO_COLOR=1          no colour in the summary' \
    '  MAINTAIN_NOTIFY=0   no desktop notification when a run finishes'
end
