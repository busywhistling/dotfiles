function maintain
  set -l timestamp_dir ~/.cache/maintain
  mkdir -p $timestamp_dir

  function should_run -a timestamp_dir step_name time time_string
    set -l timestamp_file $timestamp_dir/$step_name.timestamp
    if test -f $timestamp_file
      set -l last_run (cat $timestamp_file)
      set -l six_hours_ago (math (date +%s) - $time)
      if test "$last_run" -gt "$six_hours_ago"
        printf "Skipping $step_name (last run < $time_string ago)\\n"
        return 1
      end
    end
    return 0
  end

  function mark_run -a timestamp_dir step_name
    date +%s > "$timestamp_dir/$step_name.timestamp"
  end

  # Commit and push the given tracked dotfiles if any changed, or if a
  # previous run's commit never made it to origin. Returns non-zero so
  # callers can retry.
  function commit_dotfiles -a message
    set -l paths $argv[2..-1]
    set -l dotfiles ~/.config/chezmoi/sourceDir
    if not git -C $dotfiles diff --quiet -- $paths
      git -C $dotfiles add $paths
      and git -C $dotfiles commit -q -m $message -- $paths
      or return 1
    end
    if not git -C $dotfiles diff --quiet origin/main..HEAD -- $paths
      env GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=5' git -C $dotfiles push -q origin HEAD:main
      or return 1
    end
    return 0
  end

  chezmoi update
{{ if eq .chezmoi.hostname "macbook" }}
  if test (hostname) = macbook
    if should_run $timestamp_dir timemachine_exclude 21600 "6 hours"
      timemachine_exclude
      mark_run $timestamp_dir timemachine_exclude
    end

    op read "op://Private/dummy/username" > /dev/null

    if should_run $timestamp_dir mbsync 21600 "6 hours"
      mbsync -a -c ~/.config/mbsyncrc
      mark_run $timestamp_dir mbsync
    end

    if test -d "/Volumes/MEDIA/Pictures"
      if should_run $timestamp_dir rsync_pictures_to_ssd 21600 "6 hours"
        rsync --archive --verbose --compress --progress --human-readable --delete --exclude='Photos Library.photoslibrary/' --exclude='Photo Booth-Mediathek/' ~/Pictures/ /Volumes/MEDIA/Pictures/
        mark_run $timestamp_dir rsync_pictures_to_ssd
      end
    else
      printf "Skipping rsync icloud-backups to external drive as it is not available...\n"
    end

    if test -d "{{ .media.libraryDir }}"
      if should_run $timestamp_dir sync_media 21600 "6 hours"
        sync_media_library
        mark_run $timestamp_dir sync_media
      end
    else
      printf "Skipping media library sync as external drive is not available...\n"
    end

    if should_run $timestamp_dir restic_backup_to_backblaze 21600 "6 hours"
      restic_backup_to_backblaze
      mark_run $timestamp_dir restic_backup_to_backblaze
    end

    if should_run $timestamp_dir sync_repos 21600 "6 hours"
      sync_repos
      mark_run $timestamp_dir sync_repos
    end

    if should_run $timestamp_dir mole 2629800 "1 month"
      printf "\n#################################################################\n"
      echo "Deep cleaning system"
      mo clean
      mark_run $timestamp_dir mole
    end
  end
{{ end }}
  if is_ubuntu
    sudo apt update; sudo apt upgrade --yes
  end

  if test (hostname) = hetzner
    if should_run $timestamp_dir podman_maintain 21600 "6 hours"
      podman auto-update

      # `auto-update` restarts the pod, and pruning while the old containers
      # are still unwinding fails with transient storage errors. Wait (max
      # 60 s) until podman answers and nothing is mid-transition, then let the
      # store settle.
      for attempt in (seq 1 30)
        set -l transitional 0
        for state in (podman ps -a --format '{{"{{"}}.State{{"}}"}}' 2>/dev/null)
          if string match -qr '^(created|configured|initialized|stopping)$' -- $state
            set transitional 1
          end
        end
        test $transitional -eq 0; and podman info >/dev/null 2>&1; and break
        sleep 2
      end
      sleep 5

      # Leftover buildah build containers and storage-only containers pin base
      # images and layers, so `image prune` cannot free them.
      podman system prune --build -f
      podman system prune --external -f

      # `--force` keeps this unattended. `system prune --all` would also delete
      # the `:previous` rollback tags, so remove the remaining unused images
      # ourselves and skip them. Retry in case a prune races the restart above.
      set -l kept_tags localhost/hometube-server:previous localhost/hometube-client:previous
      set -l cleaned 0
      for attempt in 1 2 3
        set -l failed 0

        podman system prune --volumes --force
        or set failed 1

        set -l protected (podman image inspect --format '{{"{{"}}.Id{{"}}"}}' $kept_tags 2>/dev/null | string replace -r '^sha256:' '')
        set -l in_use (podman ps -a --no-trunc --format '{{"{{"}}.ImageID{{"}}"}}' 2>/dev/null | string replace -r '^sha256:' '')
        for id in (podman images --no-trunc --format '{{"{{"}}.ID{{"}}"}}' 2>/dev/null | sort -u)
          set -l image (string replace -r '^sha256:' '' -- $id)
          if contains -- $image $protected $in_use
            continue
          end
          podman rmi --force $image
          or set failed 1
        end

        if test $failed -eq 0
          set cleaned 1
          break
        end
        printf "podman image cleanup failed (attempt %s/3); retrying\n" $attempt
        test $attempt -lt 3; and sleep (math "10 * $attempt")
      end

      # Orphaned layers are invisible to `system df` and `image prune`.
      # Report only: `check --repair` would delete in-use images (the
      # opentodo /etc mtime warnings are benign).
      set -l orphaned_layers (podman system check 2>&1 | grep -c "not referenced by any images or containers")
      if test $orphaned_layers -gt 0
        printf "warning: %s orphaned podman layers — inspect with podman system check\n" $orphaned_layers
      end

      if test $cleaned -eq 0
        printf "warning: podman storage cleanup failed; will retry next maintain\n"
      else
        mark_run $timestamp_dir podman_maintain
      end
    end
  end

  if command -q brew; and should_run $timestamp_dir brew 21600 "6 hours"
    brew cu -qacy; brew upgrade --no-ask
    # if command -sq agent-browser
    #   agent-browser upgrade
    # end
    printf "\nBacking up brew bundle to ~/.config/Brewfile-$hostname\n"
    brewdump
{{ if eq .chezmoi.hostname "macbook" }}
    # Stage the fresh dump; the single Brewfile commit further down covers it.
    chezmoi add ~/.config/Brewfile-macbook
    or printf "warning: could not stage the macbook Brewfile; will retry next run\n"
{{ end }}
    brew autoremove
    brew cleanup --prune=all
    mark_run $timestamp_dir brew
  end
{{ if eq .chezmoi.hostname "macbook" }}
  if should_run $timestamp_dir update_neovim_plugins 21600 "6 hours"
    if nvim --headless "+lua vim.pack.update(nil, { force = true })" +qa
      chezmoi add ~/.config/nvim/nvim-pack-lock.json
      mark_run $timestamp_dir update_neovim_plugins
    end
  end
{{ end }}{{ if eq .chezmoi.hostname "macbook" }}
  if test (hostname) = macbook
    if should_run $timestamp_dir hetzner_maintain 21600 "6 hours"
      printf "\n#################################################################\n"
      echo "Maintaining hetzner"
      ssh -o ConnectTimeout=5 -o BatchMode=yes hetzner maintain 2>&1 | tee $timestamp_dir/hetzner-last.log
      set -l hetzner_status $pipestatus[1]
      if test $hetzner_status -eq 0
        mark_run $timestamp_dir hetzner_maintain
      else
        printf "warning: hetzner maintenance failed (status %s); will retry next run\n" $hetzner_status
      end

      # Hetzner runs containers, so only report a pending reboot here.
      set -l hetzner_reboot 0
      ssh -o ConnectTimeout=5 -o BatchMode=yes hetzner test -e /run/reboot-required; and set hetzner_reboot 1
      ssh -o ConnectTimeout=5 -o BatchMode=yes hetzner 'test "$(ls -1 /lib/modules | sort -V | tail -1)" != "$(uname -r)"'; and set hetzner_reboot 1
      test $hetzner_reboot -eq 1; and printf "hetzner: reboot recommended (kernel/firmware update pending)\n"
    end

    # `brewdump` rewrites ~/.config/Brewfile-hetzner on the server during the
    # remote maintain, and the server owns that file. Fetch the result; the
    # single Brewfile commit below covers it.
    if should_run $timestamp_dir hetzner_brewfile 21600 "6 hours"
      if scp -q -o ConnectTimeout=5 -o BatchMode=yes hetzner:~/.config/Brewfile-hetzner ~/.config/Brewfile-hetzner
        chezmoi add ~/.config/Brewfile-hetzner
        and mark_run $timestamp_dir hetzner_brewfile
        or printf "warning: could not stage the hetzner Brewfile; will retry next run\n"
      else
        printf "warning: could not fetch the hetzner Brewfile; will retry next run\n"
      end
    end

    # One commit for both files: the Mac's own dump and the fetched copy.
    commit_dotfiles "chore(brew): sync the Brewfiles" \
      private_dot_config/private_Brewfile-macbook \
      private_dot_config/private_Brewfile-hetzner
    or printf "warning: could not commit the Brewfiles; will retry next run\n"

    if should_run $timestamp_dir dietpi_maintain 86400 "24 hours"
      printf "\n#################################################################\n"
      echo "Maintaining dietpi"
      maintain_dietpi 2>&1 | tee $timestamp_dir/dietpi-last.log
      set -l dietpi_status $pipestatus[1]
      if test $dietpi_status -eq 0
        mark_run $timestamp_dir dietpi_maintain
      else
        printf "warning: dietpi maintenance failed (status %s); will retry next run\n" $dietpi_status
      end
    end

    if not test -f ~/Documents/vps_backups/(date +%F)/hometube.db
      printf "\n#################################################################\n"
      echo "Backing up hometube"
      backup_hometube 2>&1 | tee $timestamp_dir/hometube-backup-last.log
      set -l hometube_status $pipestatus[1]
      if test $hometube_status -ne 0
        printf "warning: hometube backup failed (status %s); will retry next run\n" $hometube_status
      end
    end
  end
{{ end }}
  if test (hostname) = hetzner
    if should_run $timestamp_dir hermes_update 21600 "6 hours"
      hermes update --yes
      mark_run $timestamp_dir hermes_update
    end
  end
{{ if eq .chezmoi.hostname "macbook" }}
  # if should_run $timestamp_dir icloud_sync 21600 "6 hours"
  #   icloud-sync --mfa-sms -u (op read "op://Private/{{ .op.items.cloudAccount }}/username") -p (op read "op://Private/{{ .op.items.cloudAccount }}/password") -d ~/Pictures/.icloud-backups/paramjit
  #   icloud-sync --mfa-sms -u (op read "op://Private/{{ .op.items.cloudAccountFamily }}/username") -p (op read "op://Private/{{ .op.items.cloudAccountFamily }}/password") -d ~/Pictures/.icloud-backups/{{ .mail.tertiary.name }}
  #   mark_run $timestamp_dir icloud_sync
  # end
{{ end }}
  functions -e should_run mark_run commit_dotfiles
end
