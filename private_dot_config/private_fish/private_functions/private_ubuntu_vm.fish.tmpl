function ubuntu_vm --description "Start '{{ .vm.name | default "Linux VM" }}' VM if needed, then ssh into it"
  set -l vm "{{ .vm.name | default "Linux VM" }}"

  if utmctl status "$vm" | grep -qi "stopped"
    echo "Starting '$vm'..."
    utmctl start "$vm"
    and echo "VM started."
  end

  ssh paramjit@{{ .vm.ip }}
end
