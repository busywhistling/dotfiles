{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "tips": false
  },
  "plugins": [
{{- if hasKey . "external" }}
{{- if .external.opencodePlugin }}
    "{{ .external.opencodePlugin }}"
{{- end }}
{{- end }}
  ],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/paramjit/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
