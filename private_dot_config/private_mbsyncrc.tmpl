# Global defaults
Create Near
Expunge Near
SyncState *
CopyArrivalDate yes
Sync Pull

# Fastmail {{ .mail.secondary.name | title }}
IMAPAccount fastmail_{{ .mail.secondary.name }}
Host imap.fastmail.com
Port 993
AuthMechs LOGIN
User {{ .mail.secondary.address }}
PassCmd "op read op://Private/{{ .op.items.mailSecondary }}/password"
TLSType IMAPS
TLSVersions +1.2

IMAPStore fastmail-remote-{{ .mail.secondary.name }}
Account fastmail_{{ .mail.secondary.name }}

# This section describes the local storage
MaildirStore fastmail-local-{{ .mail.secondary.name }}
Path ~/Documents/mailboxes/fastmail-{{ .mail.secondary.name }}/
Inbox ~/Documents/mailboxes/fastmail-{{ .mail.secondary.name }}/Inbox
SubFolders Verbatim

# This section a "channel", a connection between remote and local
Channel fastmail_{{ .mail.secondary.name }}
Far :fastmail-remote-{{ .mail.secondary.name }}:
Near :fastmail-local-{{ .mail.secondary.name }}:
Patterns *

