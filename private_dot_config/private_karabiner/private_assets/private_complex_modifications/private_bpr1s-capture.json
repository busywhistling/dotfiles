{
  "title": "BPR1S Remote (BOXPUT / SIMONTEK)",
  "rules": [
    {
      "description": "BPR1S: dead buttons -> F13-F19 (scoped to this remote only)",
      "manipulators": [
        {
          "type": "basic",
          "description": "AC Back -> F13",
          "from": { "consumer_key_code": "ac_back", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "f13" }],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "vendor_id": 7514, "product_id": 49281, "description": "BOXPUT BPR1S" }]
            }
          ]
        },
        {
          "type": "basic",
          "description": "AC Home -> F14",
