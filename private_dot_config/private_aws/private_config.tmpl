{{ if .aws.accountId -}}
[profile {{ .aws.profile }}]
sso_session = {{ .aws.profile }}
sso_account_id = {{ .aws.accountId }}
sso_role_name = AdministratorAccess
region = eu-central-1

[sso-session {{ .aws.profile }}]
sso_start_url = https://identitycenter.amazonaws.com/{{ .aws.ssoInstance }}
sso_region = eu-central-1
sso_registration_scopes = sso:account:access
{{- end }}
