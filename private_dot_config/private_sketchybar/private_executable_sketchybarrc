PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar. Available options:
# https://felixkratz.github.io/SketchyBar/config/bar
sketchybar --bar position=top display=main topmost=window height=32 color=0xFF000000

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items
default=(
  icon.font="SF Pro:Regular:16"
  label.font="SF Pro:Semibold:12"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

# TODO: Replace update_freq with triggers
sketchybar --add item clock left \
           --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh" \
           --add item chezmoi left \
           --set chezmoi update_freq=300 script="$PLUGIN_DIR/chezmoi.sh" \
           --set chezmoi label.color=0xffff0000 \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item cdp right \
           --set cdp update_freq=5 script="$PLUGIN_DIR/cdp.sh" \
           --set cdp label.color=0xffffff00 \
           --subscribe cdp system_woke

sketchybar --update
