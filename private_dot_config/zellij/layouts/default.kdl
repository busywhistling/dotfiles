layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}#[bg=#181926]{tabs}"
                format_center "#[bg=#181926,fg=#494d64]({session})"

                // You can put `{pipe_zjstatus_hints}` inside of format_left, format_center, or format_right.
                // The pipe name should match the pipe_name configuration option from above, which is zjstatus_hints by default.
                // e.g. pipe_<pipe_name>
                format_right  "{pipe_zjstatus_hints}" 

                // Note: this is necessary or else zjstatus won't render the pipe:
                pipe_zjstatus_hints_format "{output}"

                // format_space  "#[bg=#181926] "
                format_hide_on_overlength "true"
                format_precedence "crl"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#6C7086]{char}"
                border_position "top"

                mode_normal        "#[bg=#a6da95,fg=#181926,bold] Zellij "
                mode_locked        "#[bg=#6e738d,fg=#181926,bold] LOCKED  "
                mode_resize        "#[bg=#8aadf4,fg=#181926,bold] RESIZE "
                mode_pane          "#[bg=#8aadf4,fg=#181926,bold] PANE "
                mode_tab           "#[bg=#8aadf4,fg=#181926,bold] TAB "
                mode_scroll        "#[bg=#8aadf4,fg=#181926,bold] SCROLL "
                mode_enter_search  "#[bg=#8aadf4,fg=#181926,bold] ENT-SEARCH "
                mode_search        "#[bg=#8aadf4,fg=#181926,bold] SEARCHARCH "
                mode_rename_tab    "#[bg=#8aadf4,fg=#181926,bold] RENAME-TAB "
                mode_rename_pane   "#[bg=#8aadf4,fg=#181926,bold] RENAME-PANE "
                mode_session       "#[bg=#8aadf4,fg=#181926,bold] SESSION "
                mode_move          "#[bg=#8aadf4,fg=#181926,bold] MOVE "
                mode_prompt        "#[bg=#8aadf4,fg=#181926,bold] PROMPT "
                mode_tmux          "#[bg=#f5a97f,fg=#181926,bold] TMUX "

                // formatting for inactive tabs
                tab_normal              "#[bg=#181926,fg=#8bd5ca,bold] {name}{floating_indicator} "
                tab_normal_fullscreen   "#[bg=#181926,fg=#8bd5ca,bold] {name}{fullscreen_indicator} "
                tab_normal_sync         "#[bg=#181926,fg=#8bd5ca,bold] {name}{sync_indicator} "

                // formatting for the current active tab
                tab_active              "#[bg=#363a4f,fg=#eed49f,bold] {name}{floating_indicator} "
                tab_active_fullscreen   "#[bg=#363a4f,fg=#eed49f,bold] {name}{fullscreen_indicator}"
                tab_active_sync         "#[bg=#363a4f,fg=#eed49f,bold] {name}{sync_indicator}"

                // separator between the tabs
                // tab_separator           "#[bg=#181926] "

                // indicators
                tab_sync_indicator       " "
                tab_fullscreen_indicator " 󰊓"
                tab_floating_indicator   " 󰹙"

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=blue] {stdout} "
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"

                datetime        "#[fg=#6C7086,bold] {format} "
                datetime_format "%A, %d %b %Y %H:%M"
                datetime_timezone "Europe/Berlin"
            }
        }
      children
    }
}
