{
	"extends": ["nolabs-ai/opencode"],
	"meta": {
		"name": "paramjit",
		"version": "1.0.0",
		"description": "Runtime-discovered path additions for opencode",
		"author": null
	},
	"security": {
		"signal_mode": null,
		"process_info_mode": null,
		"ipc_mode": null,
		"capability_elevation": null,
		"approval_backends": {},
		"approval_defaults": null,
		"wsl2_proxy_policy": null
	},
	"groups": {
		"include": [],
		"exclude": []
	},
	"commands": {
		"allow": [],
		"deny": []
	},
	"filesystem": {
		"allow": [
			// Brave's --user-data-dir; must be writable or Brave refuses to start.
			"$HOME/.local/share/agent-browser-brave-profile",
			"~/Library/Application Support/switchbot-meter"
		],
		"read": ["~/.config", "~/.config/nono", "~/Documents"],
		"write": [],
		"allow_file": [],
		"read_file": [],
		"write_file": [],
		"unix_socket": [],
		"unix_socket_bind": [],
		"unix_socket_dir": [],
		"unix_socket_dir_bind": [],
		"unix_socket_subtree": [],
		"unix_socket_subtree_bind": [],
		"deny": [],
		"bypass_protection": [],
		"suppress_save_prompt": []
	},
	"network": {
		"block": false,
		"allow_http2": false,
		"allow_domain": [],
		"deny_domain": [],
		"open_port": [],
		"open_port_range": [],
		// CDP endpoint Brave listens on for agent-browser --cdp 9222.
		"listen_port": [9222],
		"listen_port_range": [],
		"connect_port": [],
		"no_proxy": [],
		"custom_credentials": {},
		"tls_intercept": null,
		"upstream_proxy": null,
		"upstream_bypass": []
	},
	"diagnostics": {
		"suppress_system_services": [],
		"redaction": {
			"extra_env_vars": []
		},
		"network_denial_audit": {}
	},
	"linux": {
		"af_unix_mediation": null,
		"sandbox_policy": null
	},
	"env_credentials": {},
	"credential_capture": {},
	"credential_providers": {},
	"credential_routes": [],
	"workdir": {
		"access": "none"
	},
	"hooks": {},
	"session_hooks": {},
	"rollback": {
		"exclude_patterns": [],
		"exclude_globs": []
	},
	"skipdirs": [],
	"packs": [],
	"command_args": [],
	"unsafe_macos_seatbelt_rules": []
}
