sourceDir = "~/.config/chezmoi/sourceDir"

{{ if eq .chezmoi.hostname "macbook" }}
# This Mac's template data is not stored here. It lives in the 1Password
# environment `chezmoi_macbook` and is supplied at runtime by the `chezmoi`
# wrapper in ~/.local/bin (private_dot_local/bin/private_executable_chezmoi).
# Bootstrap a new Mac by installing that wrapper first, or run the real
# chezmoi with --override-data-file until it is in place.
{{ else }}
# Personal values. None of these are committed: chezmoi writes the answers to
# ~/.config/chezmoi/chezmoi.toml, which is outside the source directory.
[data]
  fullName = "{{ promptStringOnce . "fullName" "Full name for git commits" }}"
  email    = "{{ promptStringOnce . "email"    "Primary git email" }}"
{{ end }}
